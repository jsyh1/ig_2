<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import java.lang.String?>
<?import javafx.collections.FXCollections?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
           	fx:controller="co.edu.poli.sw2.controlador.DronController"
            style="-fx-background-color: #f4f6f8;">

    <top>
        <VBox spacing="5" style="-fx-background-color: linear-gradient(to right, #2c3e50, #34495e);">
            <padding>
                <Insets top="22" right="25" bottom="18" left="25"/>
            </padding>

            <Label text="Gestión de Drones"
                   style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: white;"/>

            <Label text="Administra el registro de drones del sistema"
                   style="-fx-font-size: 13px; -fx-text-fill: #bdc3c7;"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="18">
            <padding>
                <Insets top="20" right="25" bottom="25" left="25"/>
            </padding>

            <!-- Formulario -->
            <VBox spacing="14"
                  style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e0e4e8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
                <padding>
                    <Insets top="18" right="20" bottom="18" left="20"/>
                </padding>

                <Label text="Datos del Drone"
                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

                <GridPane hgap="18" vgap="12">

                    <Label text="ID:"
                           style="-fx-font-weight: 600; -fx-text-fill: #566573;"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="0"/>

                    <TextField fx:id="txtId"
                               promptText="ID del drone"
                               style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #d0d5da; -fx-padding: 6 10;"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="0"/>


                    <Label text="Señal:"
                           style="-fx-font-weight: 600; -fx-text-fill: #566573;"
                           GridPane.columnIndex="2"
                           GridPane.rowIndex="0"/>

                    <TextField fx:id="txtSenal"
                               promptText="Señal"
                               style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #d0d5da; -fx-padding: 6 10;"
                               GridPane.columnIndex="3"
                               GridPane.rowIndex="0"/>


                    <Label text="Modelo:"
                           style="-fx-font-weight: 600; -fx-text-fill: #566573;"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="1"/>

                    <TextField fx:id="txtModelo"
                               promptText="Modelo del drone"
                               style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #d0d5da; -fx-padding: 6 10;"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="1"/>


                    <Label text="Peso:"
                           style="-fx-font-weight: 600; -fx-text-fill: #566573;"
                           GridPane.columnIndex="2"
                           GridPane.rowIndex="1"/>

                    <TextField fx:id="txtPeso"
                               promptText="Peso del drone"
                               style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #d0d5da; -fx-padding: 6 10;"
                               GridPane.columnIndex="3"
                               GridPane.rowIndex="1"/>


                    <Label text="Tipo:"
                           style="-fx-font-weight: 600; -fx-text-fill: #566573;"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="2"/>

                    <ChoiceBox fx:id="cbTipo"
                               prefWidth="200"
                               style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #d0d5da;"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="2">
                        <items>
                            <FXCollections fx:factory="observableArrayList">
                                <String fx:value="Vigilancia"/>
                                <String fx:value="Agricultura"/>
                            </FXCollections>
                        </items>
                        <value>
                            <String fx:value="Seleccionar"/>
                        </value>
                    </ChoiceBox>

                </GridPane>

                <!-- Botones -->
                <HBox spacing="12">

                    <Button fx:id="btnNuevo"
                            text="Nuevo"
                            prefWidth="110"
                            style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;"
                            onAction="#nuevoDron"/>

                    <Button fx:id="btnGuardar"
                            text="Guardar"
                            prefWidth="110"
                            style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;"
                            onAction="#guardarDron"/>

                    <Button fx:id="btnEditar"
                            text="Editar"
                            prefWidth="110"
                            style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;"
                            onAction="#editarDron"/>

                    <Button fx:id="btnEliminar"
                            text="Eliminar"
                            prefWidth="110"
                            style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;"
                            onAction="#eliminarDron"/>

                </HBox>

            </VBox>


            <!-- Tabla -->
            <VBox spacing="10"
                  VBox.vgrow="ALWAYS"
                  style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e0e4e8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
                <padding>
                    <Insets top="18" right="20" bottom="18" left="20"/>
                </padding>

                <Label text="Drones registrados"
                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

                <TableView fx:id="tblDrones"
                           VBox.vgrow="ALWAYS"
                           style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #e0e4e8;">

                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>

                    <columns>

                        <TableColumn fx:id="colId"
                                     text="ID"
                                     prefWidth="100"/>

                        <TableColumn fx:id="colSenal"
                                     text="Señal"
                                     prefWidth="150"/>

                        <TableColumn fx:id="colModelo"
                                     text="Modelo"
                                     prefWidth="200"/>

                        <TableColumn fx:id="colPeso"
                                     text="Peso"
                                     prefWidth="150"/>

                    </columns>

                </TableView>

            </VBox>

        </VBox>
    </center>

</BorderPane>
