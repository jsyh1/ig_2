<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
           	fx:controller="co.edu.poli.sw2.controlador.DronController">

    <top>
        <VBox spacing="5">
            <padding>
                <Insets top="20" right="25" bottom="10" left="25"/>
            </padding>

            <Label text="Drones"
                   style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="15">
            <padding>
                <Insets top="10" right="25" bottom="20" left="25"/>
            </padding>

            <!-- Formulario -->
            <VBox spacing="10">

                <Label text="Datos del Drone"
                       style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

                <GridPane hgap="15" vgap="10">

                    <Label text="ID:"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="0"/>

                    <TextField fx:id="txtId"
                               promptText="ID del drone"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="0"/>


                    <Label text="Señal:"
                           GridPane.columnIndex="2"
                           GridPane.rowIndex="0"/>

                    <TextField fx:id="txtSenal"
                               promptText="Señal"
                               GridPane.columnIndex="3"
                               GridPane.rowIndex="0"/>


                    <Label text="Modelo:"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="1"/>

                    <TextField fx:id="txtModelo"
                               promptText="Modelo del drone"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="1"/>


                    <Label text="Peso:"
                           GridPane.columnIndex="2"
                           GridPane.rowIndex="1"/>

                    <TextField fx:id="txtPeso"
                               promptText="Peso del drone"
                               GridPane.columnIndex="3"
                               GridPane.rowIndex="1"/>

                </GridPane>

                <!-- Botones -->
                <HBox spacing="10">

                    <Button fx:id="btnNuevo"
                            text="Nuevo"
                            prefWidth="100"
                            onAction="#nuevoDron"/>

                    <Button fx:id="btnGuardar"
                            text="Guardar"
                            prefWidth="100"
                            onAction="#guardarDron"/>

                    <Button fx:id="btnEditar"
                            text="Editar"
                            prefWidth="100"
                            onAction="#editarDron"/>

                    <Button fx:id="btnEliminar"
                            text="Eliminar"
                            prefWidth="100"
                            onAction="#eliminarDron"/>

                </HBox>

            </VBox>


            <!-- Tabla -->
            <VBox spacing="10"
                  VBox.vgrow="ALWAYS">

                <Label text="Drones registrados"
                       style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

                <TableView fx:id="tblDrones"
                           VBox.vgrow="ALWAYS">

                    <columns>

                        <TableColumn fx:id="colId"
                                     text="ID"
                                     prefWidth="100"/>

                        <TableColumn fx:id="colSenal"
                                     text="Señal"
                                     prefWidth="150"/>

                        <TableColumn fx:id="colModelo"
                                     text="Modelo"
                                     prefWidth="200"/>

                        <TableColumn fx:id="colPeso"
                                     text="Peso"
                                     prefWidth="150"/>

                    </columns>

                </TableView>

            </VBox>

        </VBox>
    </center>

</BorderPane>
